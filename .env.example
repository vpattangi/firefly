# Copy to .env.local (git-ignored) and fill in.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Google Cloud → enable the Routes API. Optional: without it routes are straight lines.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EAiSER for Campuses (optional). Without it, reports are classified by an on-device stand-in, marked "simulated".
EXPO_PUBLIC_EAISER_URL=
EXPO_PUBLIC_EAISER_KEY=
